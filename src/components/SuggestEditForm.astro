---
/**
 * SuggestEditForm.astro — "Suggest an edit" form (ported from the district concept).
 *
 * Phase A: real form markup with a honeypot; posts to /api/suggest (not yet live).
 * Phase C wires the Cloudflare Pages Function + Turnstile and the thank-you redirect.
 */
interface Props {
  district: number;
}
const { district } = Astro.props;
const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<section class="block"><div class="wrap">
  <div class="sec-head"><span class="n">06</span><h2>Suggest an edit</h2></div>
  <div class="form-wrap">
    <p style="margin:0;color:var(--ink-2);font-size:.92rem;">See something out of date or incorrect on this page? Let us know &mdash; every district page links to primary sources, and we correct errors quickly.</p>
    <form method="POST" action={`${b}api/suggest`} data-district={district}>
      <input type="hidden" name="district" value={district} />
      {/* Honeypot — bots fill this; humans never see it. */}
      <div style="position:absolute;left:-9999px;" aria-hidden="true">
        <label>Leave this field empty <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>
      <label for={`se-name-${district}`}>Your name</label>
      <input id={`se-name-${district}`} name="name" type="text" autocomplete="name" />
      <label for={`se-email-${district}`}>Email address</label>
      <input id={`se-email-${district}`} name="email" type="email" autocomplete="email" required />
      <label for={`se-msg-${district}`}>What needs updating?</label>
      <textarea id={`se-msg-${district}`} name="message" required></textarea>
      {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="auto" style="margin-top:1rem;"></div>}
      <button class="btn primary" type="submit">Submit suggestion</button>
    </form>
  </div>
</div></section>

---
/**
 * NameDistrictForm.astro — "Name the district" form (rebuilt in the design system).
 *
 * Phase A/B′: real form markup with a honeypot; posts to /api/name (not yet live).
 * Phase C wires the Cloudflare Pages Function + Turnstile. (The old Netlify Forms wiring
 * does not work on Cloudflare Pages — removed.)
 */
interface Props {
  district: number;
}
const { district } = Astro.props;
const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<div class="form-wrap" style="max-width:560px;">
  <form method="POST" action={`${b}api/name`} data-district={district}>
    <input type="hidden" name="district" value={district} />
    {/* Honeypot */}
    <div style="position:absolute;left:-9999px;" aria-hidden="true">
      <label>Leave this field empty <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
    </div>
    <label for={`nd-name-${district}`}>Your name</label>
    <input id={`nd-name-${district}`} name="name" type="text" autocomplete="name" required />
    <label for={`nd-email-${district}`}>Email address</label>
    <input id={`nd-email-${district}`} name="email" type="email" autocomplete="email" required />
    <label for={`nd-suggestion-${district}`}>Suggested name for District {district}</label>
    <input id={`nd-suggestion-${district}`} name="suggested_name" type="text" required />
    <label for={`nd-reason-${district}`}>Why this name? (optional)</label>
    <textarea id={`nd-reason-${district}`} name="reason"></textarea>
    {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="auto" style="margin-top:1rem;"></div>}
    <button class="btn primary" type="submit">Submit name</button>
  </form>
</div>

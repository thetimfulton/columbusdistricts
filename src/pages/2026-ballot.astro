import { SITE_LAUNCHED, BALLOT_UPDATED, formatReviewDate, utm } from "../lib/site";
const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
const updated = formatReviewDate(BALLOT_UPDATED);
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

// Primary sources and press coverage. Link with u(key, "slot") so each click carries UTMs.
const SRC = {
  cqi: "https://vote.franklincountyohio.gov/getmedia/4001b052-1b90-4f73-b030-2d981e6ec8fa/2026-General-Certified-Questions-and-Issues",
  notice8: "https://vote.franklincountyohio.gov/getmedia/258ab3a2-ddef-42a8-a869-c38b6c068a06/Notice-of-Election-Columbus-Charter-Amendment-1-Petition",
  notice9: "https://vote.franklincountyohio.gov/getmedia/a3d9d75e-83ff-492a-98c4-a8cc09e1cd60/Notice-of-Election-Columbus-Charter-Amendment-2-Council",
  full8: "https://vote.franklincountyohio.gov/getmedia/a7a2dd78-e53f-4e74-933a-0ba0de9aaa4c/8-Full-OCOS-Charter-Amendment",
  full9: "https://vote.franklincountyohio.gov/getmedia/6ea104b7-9ca4-4f85-8712-40ca51d2d4e9/9-Full-Charter-Amendment-No-2",
  boe2026: "https://vote.franklincountyohio.gov/election-info/2026",
  wosu0923: "https://www.wosu.org/politics-government/2026-09-23/franklin-county-democrats-endorse-both-ballot-issues-to-reform-columbus-city-council",
  abc60924: "https://abc6onyourside.com/news/local/issue-8-vs-issue-9-what-columbus-voters-need-to-know-before-election-day-november-ballot-amendment-city-council",
  dispatch0824: "https://www.dispatch.com/story/news/politics/2026/08/24/two-columbus-city-council-reform-amendments-headed-to-november-ballot/91389533007/",
  wosu0824: "https://www.wosu.org/politics-government/2026-08-24/columbus-city-council-sends-two-council-reform-amendments-to-november-ballot",
  wosu0821: "https://www.wosu.org/politics-government/2026-08-21/columbus-city-council-proposes-a-13-member-council-with-new-district-map-and-more-reforms",
  wosu0818: "https://www.wosu.org/politics-government/2026-08-18/labor-and-black-leaders-raise-concerns-on-columbus-city-council-reform-effort",
  wosu0716: "https://www.wosu.org/politics-government/2026-07-16/our-city-our-say-submits-23-000-signatures-to-force-a-vote-on-how-columbus-elects-city-council",
  sosVoters: "https://www.ohiosos.gov/elections/voters/",
  sosCalendar: "https://www.ohiosos.gov/assets/election-calendar-2026.pdf",
} as const;
const u = (key: keyof typeof SRC, slot: string) => utm(SRC[key], slot);

// Verbatim ballot language — Franklin County BOE Notices of Election, dated Sept. 14, 2026.
const QUESTION = "Shall the proposed charter amendment be approved?";
const ballot8 = [
  "This proposed charter amendment would limit the ability to vote for candidates for Columbus City Council to only those electors living within the districts that those candidates seek to represent.",
  "The amendment specifies that ballots within council districts will include both citywide races as well as the district race.",
  "The amendment allows for the initiation of a recall election of a council district representative if a petition is submitted bearing the signatures of the electors of that district in an amount that is at least fifteen (15%) percent of the votes cast within the district in the preceding mayoral election.",
];
const ballot9Lead = [
  "This proposed charter amendment would limit the ability to vote for candidates for Columbus City Council to only those electors living within the districts that those candidates seek to represent.",
  "The amendment adds two (2) at-large council representatives to be elected in 2027 and seated in 2028, and an additional two (2) at-large council representatives to be elected in 2029 and seated in 2030. All at-large council representatives will be elected for four (4) year terms.",
  "The amendment includes provisions for transitioning from the current nine (9) member Council to an eleven (11) member Council and then subsequently to a thirteen (13) member Council, allowing for the ongoing staggering of terms.",
];
const ballot9Rest = [
  "The amendment allows councilmembers representing districts whose boundaries are redrawn but who still have at least two years remaining in their term to serve the remainder of their term representing a newly-drawn district.",
  "The amendment specifies that candidates for council district seats must have resided within their district for at least one year prior to the primary election.",
  "The amendment calls for a redraw of the current council district map to occur in 2027, and increases the maximum population variance between districts from 1% to 7.5%.",
  "The amendment updates the vote requirements for expelling and/or removing councilmembers for misconduct, malfeasance, misfeasance, or nonfeasance. The amendment updates the expulsion vote threshold for conduct from “six” to “2/3rds,” and the expulsion vote for absences from “three-fifths” to “2/3rds.”",
  "The amendment updates the charter to reflect the minimum number of councilmembers necessary to achieve a quorum for the purposes of meeting for business.",
  "The amendment increases the number of affirmative votes that would be needed to adopt ordinances or resolutions in concert with expanding the size of the legislature.",
  "The amendment specifies that candidates for district councilmember must collect at least 150 signatures of electors from within their district, and that at-large candidates must collect at least 250 signatures of electors from within the city limits.",
  "The amendment specifies that ballots within council districts will include both citywide races as well as the district race.",
  "The amendment allows for the initiation of a recall election of a council district representative if a petition is submitted bearing the signatures of the electors of that district in an amount equal to or greater than fifteen (15%) percent of the votes cast within the district in the preceding mayoral election. The amendment allows for the initiation of a recall election of an at-large representative if a petition is submitted bearing the signatures of the electors citywide in an amount equal to or greater than fifteen (15%) percent of the votes cast within the district in the preceding mayoral election.",
];

// Structured data: the explainer as an Article, plus the on-page FAQ (answers mirror visible copy).
const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Columbus Issues 8 and 9: how City Council is elected is on the 2026 ballot",
  description:
    "A nonpartisan explainer of Columbus Issues 8 and 9, the two charter amendments on how City Council is elected, with the certified ballot language.",
  datePublished: SITE_LAUNCHED,
  dateModified: BALLOT_UPDATED,
  mainEntityOfPage: pageUrl,
  author: { "@type": "Organization", name: "Columbus Districts" },
  publisher: { "@type": "Organization", name: "Columbus Districts" },
};
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What are Columbus Issues 8 and 9?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Two proposed amendments to the Columbus City Charter on the November 3, 2026 ballot. Issue 8, placed on the ballot by citizen petition, would have each City Council member elected only by voters in their own district. Issue 9, referred by City Council, makes the same change and adds four members elected citywide, growing council to 13 members by 2030.",
      },
    },
    {
      "@type": "Question",
      name: "Can I vote yes on both Issue 8 and Issue 9?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Issue 8 and Issue 9 are separate questions on your ballot, and you vote on each one independently — you can support one, both, or neither.",
      },
    },
    {
      "@type": "Question",
      name: "What happens if both Issue 8 and Issue 9 pass?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Both amendments make the same change to how district seats are elected, and Issue 9 adds four at-large seats and other changes on top. WOSU reports the combined result would be a 13-member council: nine members elected only by the voters in their districts plus four elected citywide.",
      },
    },
    {
      "@type": "Question",
      name: "How does Columbus elect its City Council today?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Columbus uses a hybrid system, in place since the 2023 elections: nine council members who must live in the district they represent, but every voter in the city votes in all nine district races.",

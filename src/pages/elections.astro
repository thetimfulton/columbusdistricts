---
/**
 * elections.astro — Election history + upcoming dates. Rebuilt in the design system,
 * rendered from elections.json.
 */
import Layout from "../components/Layout.astro";
import electionsData from "../data/elections.json";
import { formatReviewDate } from "../lib/site";

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";

const elections = electionsData.elections.slice().reverse(); // most recent first
const upcoming = electionsData.upcoming;
const fmtPct = (v: number | null) => (v == null ? "" : v.toFixed(1) + "%");
const reviewed = formatReviewDate();
---
<Layout
  title="Elections"
  description="Columbus City Council election history — district results, upcoming races, and voter resources, sourced from the Franklin County Board of Elections."
  active="elections"
>
  <div class="wrap"><div class="article" style="max-width:900px;">
    <section class="art-hero">
      <div class="eyebrow">Elections</div>
      <h1>Council district elections</h1>
      <p class="dek">A running record of Columbus City Council district results and upcoming dates. All results sourced from the Franklin County Board of Elections.</p>
    </section>

    <div class="callout" style="border-left-color:var(--accent);">
      <b>Upcoming: {upcoming.year}.</b> Districts on the ballot: {upcoming.districts_on_ballot.join(", ")}. {upcoming.notes} Primaries are typically held in May, the general election in November. Filing information is available from the <a href={upcoming.filing_info_url} target="_blank" rel="noopener">Franklin County Board of Elections</a>.
    </div>

    {elections.map((election: any) => (
      <section style="margin-top:2.4rem;">
        <div class="sec-head"><span class="n">{election.year}</span><h2>{election.year} {election.type} Election</h2></div>
        <p>{election.description}</p>
        {election.date && <p style="font-size:.86rem;color:var(--ink-3);margin-top:-.6rem;">Election date: {election.date}</p>}
        {election.term_note && <p style="font-style:italic;color:var(--ink-2);">{election.term_note}</p>}
        {election.primary && (
          <div class="callout"><b>Primary ({election.primary.date}):</b> {election.primary.notes}</div>
        )}

        {election.primary?.district_7_primary && (
          <div class="result-grid">
            <div class="result-card">
              <h3>District 7 Primary ({election.primary.date})</h3>
              <div class="cmptable-wrap" style="box-shadow:none;">
                <table class="cmpt" style="min-width:0;">
                  <thead><tr>
                    <th class="dcol" style="text-align:left">Candidate</th><th style="text-align:left">Party</th><th>Votes</th><th>%</th><th></th>
                  </tr></thead>
                  <tbody>
                    {election.primary.district_7_primary.map((c: any) => (
                      <tr class={c.winner ? "winrow" : ""}>
                        <td class="dcol" style="text-align:left">{c.name}</td>
                        <td class="mcol">{c.party || "—"}</td>
                        <td><span class="num">{c.votes ? c.votes.toLocaleString("en-US") : "—"}</span></td>
                        <td><span class="num">{fmtPct(c.pct)}</span></td>
                        <td class="mcol" style="color:var(--good);font-weight:700;">{c.winner ? "✓ Advanced" : ""}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p style="font-size:.82rem;color:var(--ink-3);font-style:italic;margin-top:.5rem;">Top two advanced to the November general election.</p>
              {election.primary.source_url && (
                <p style="font-size:.76rem;color:var(--ink-3);margin-top:.4rem;">Source: <a href={election.primary.source_url} target="_blank" rel="noopener">Franklin County BOE — certified primary canvass</a></p>
              )}
            </div>
          </div>
        )}

        {election.measures ? (
          <div class="result-grid">
            {election.measures.map((m: any) => (
              <div class="result-card">
                <div style="font-size:.74rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-ink);">{m.label}</div>
                <h3>{m.title}</h3>
                <p style="font-size:.9rem;color:var(--ink-2);margin:.2rem 0 .8rem;">{m.description}</p>
                <a class="btn ghost" href={`${b}${m.path}`}>Read the explainer &rarr;</a>
              </div>
            ))}
          </div>
        ) : (
          <div class="result-grid">
            {election.districts.map((d: any) => (
              <div class="result-card">
                <h3>District {d.district}</h3>
                <div class="cmptable-wrap" style="box-shadow:none;">
                  <table class="cmpt" style="min-width:0;">
                    <thead><tr>
                      <th class="dcol" style="text-align:left">Candidate</th><th style="text-align:left">Party</th><th>Votes</th><th>%</th><th></th>
                    </tr></thead>
                    <tbody>
                      {d.candidates.map((c: any) => (
                        <tr class={c.winner ? "winrow" : ""}>
                          <td class="dcol" style="text-align:left">{c.name}</td>
                          <td class="mcol">{c.party || "—"}</td>
                          <td><span class="num">{c.votes ? c.votes.toLocaleString("en-US") : "—"}</span></td>
                          <td><span class="num">{fmtPct(c.pct)}</span></td>
                          <td class="mcol" style="color:var(--good);font-weight:700;">{c.winner ? "✓ Elected" : ""}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {d.notes && <p style="font-size:.82rem;color:var(--ink-3);font-style:italic;margin-top:.5rem;">{d.notes}</p>}
              </div>
            ))}
          </div>
        )}
        <p style="font-size:.78rem;color:var(--ink-3);margin-top:1rem;">Source: <a href={election.source_url} target="_blank" rel="noopener">{election.source}</a></p>
      </section>
    ))}

    <section style="margin-top:2.4rem;">
      <div class="sec-head"><span class="n">Nov. 3, 2026</span><h2>Key dates for the 2026 general election</h2></div>
      <p>Ohio's 2026 general election is <strong>Tuesday, November 3, 2026</strong> (polls open 6:30&nbsp;a.m.–7:30&nbsp;p.m.). Deadlines below are from the Ohio Secretary of State's 2026 election calendar.</p>
      <div class="keyfacts">
        <div class="kf"><div class="kfl">Register or update by</div><div class="kfv">Mon, Oct 5, 2026</div></div>
        <div class="kf"><div class="kfl">Early in-person voting begins</div><div class="kfv">Tue, Oct 6, 2026</div></div>
        <div class="kf"><div class="kfl">Request a mail ballot by</div><div class="kfv">Tue, Oct 27, 2026</div></div>
      </div>
      <p style="font-size:.8rem;color:var(--ink-3);margin-top:.8rem;">Source: <a href="https://www.ohiosos.gov/assets/election-calendar-2026.pdf" target="_blank" rel="noopener">Ohio Secretary of State — 2026 Ohio Elections Calendar</a>. Confirm times and any late changes with the <a href="https://boe.franklincountyohio.gov" target="_blank" rel="noopener">Franklin County Board of Elections</a>.</p>
    </section>

    <section style="margin-top:2.4rem;">
      <div class="sec-head"><span class="n">Resources</span><h2>Voter resources</h2></div>
      <p><strong>Register to vote:</strong> <a href="https://www.ohiosos.gov/elections/voters/" target="_blank" rel="noopener">Ohio Secretary of State</a></p>
      <p><strong>Find your district:</strong> <a href="https://columbus.maps.arcgis.com/apps/webappviewer/index.html?id=7db35f3529294a6d8eaff9dac0958189" target="_blank" rel="noopener">City of Columbus ArcGIS District Finder</a></p>
      <p><strong>Board of Elections:</strong> <a href="https://boe.franklincountyohio.gov" target="_blank" rel="noopener">Franklin County Board of Elections</a></p>
      <p><strong>Running for council:</strong> Contact the <a href="https://boe.franklincountyohio.gov" target="_blank" rel="noopener">Franklin County Board of Elections</a> for petition and filing requirements.</p>
    </section>

    <p style="font-size:.82rem;color:var(--ink-3);margin-top:2rem;padding-top:1rem;border-top:1px solid var(--line);">Last reviewed: {reviewed}</p>
  </div></div>
</Layout>

<style>
  .result-grid { display: grid; gap: 1.2rem; grid-template-columns: 1fr; margin-top: 1rem; }
  @media (min-width: 720px) { .result-grid { grid-template-columns: 1fr 1fr; } }
  .result-card { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.2rem; background: var(--surface); }
  .result-card h3 { font-family: var(--serif); font-size: 1.15rem; color: var(--ink); margin: 0 0 .6rem; }
  .result-card table.cmpt tr.winrow td { background: var(--accent-soft); }
  .result-card table.cmpt tr.winrow td .num { color: var(--accent-ink); font-weight: 700; }
</style>

---
/**
 * index.astro — Homepage. Rebuilt from design-concepts/home.html.
 * Interactive nine-district map hero + "who represents you" grid + ballot band + quick links.
 * Data-driven from the district JSONs + district-boundaries.json.
 */
import Layout from "../components/Layout.astro";
import boundaries from "../data/district-boundaries.json";
import { districts, currentSnapshot } from "../lib/districts";

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";

const numberWords = ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine"];

// One card per district
const cards = districts.map((d: any) => ({
  number: d.number,
  slug: d.slug,
  member: d.councilMember.name,
  neighborhoods: d.neighborhoods.slice(0, 3).join(" · "),
  pop2020: d.population2020 ?? currentSnapshot(d).data.total_population,
}));

const members: Record<string, string> = {};
for (const d of districts) members[String(d.number)] = d.councilMember.name;
const membersJSON = JSON.stringify(members);
const slugs: Record<string, string> = {};
for (const d of districts) slugs[String(d.number)] = d.slug;
const slugsJSON = JSON.stringify(slugs);
const centroids = boundaries.centroids as Record<string, [number, number]>;

// Homepage FAQ — answers the real "what district am I in / who represents me" lookups.
// Visible copy below and this JSON-LD are kept in sync (Google requires they match).
const faqs = [
  {
    q: "What City Council district am I in?",
    a: "Columbus is divided into nine City Council districts. To find which one you live in, look up your home address with the City of Columbus district finder, or compare all nine districts to see their neighborhoods and boundaries.",
    more: [
      { href: "https://columbus.maps.arcgis.com/apps/webappviewer/index.html?id=7db35f3529294a6d8eaff9dac0958189", text: "City of Columbus district finder", external: true },
      { href: `${b}all-districts/`, text: "compare all nine districts", external: false },
    ],
  },
  {
    q: "Who is my Columbus city council member?",
    a: "Because Columbus currently elects its council members citywide, all nine members represent you — but each one must live in, and is tied to, a specific district. You can see who represents each of the nine districts on this page.",
    more: [{ href: `${b}all-districts/`, text: "see all nine council members", external: false }],
  },
  {
    q: "How many City Council districts does Columbus have?",
    a: "Columbus has nine City Council districts. They were created by a 2018 charter amendment that expanded the council from seven at-large seats to nine district-based seats, first filled in the 2023 election.",
    more: [{ href: `${b}how-it-works/`, text: "how Columbus City Council works", external: false }],
  },
  {
    q: "Do I vote for one council member or all nine?",
    a: "Right now, all nine. Columbus uses a hybrid system in which every voter votes in all nine district races. That may change: two charter amendments on the November 3, 2026 ballot would move toward district-only elections and/or expand the council. Read the 2026 ballot explainer for details.",
    more: [{ href: `${b}2026-ballot/`, text: "2026 ballot explainer", external: false }],
  },
];
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<Layout
  fullTitle="Find Your Columbus, Ohio City Council District"
  title="Find your Columbus City Council district"
  description="Look up your address to see who represents you on Columbus City Council, compare all nine districts, and find out what's on the 2026 ballot."
  active="home"
  jsonLd={faqLd}
>
  {/* ---- Hero + interactive map ---- */}
  <section class="hero home-hero"><div class="wrap"><div class="hero-grid">
    <div>
      <div class="eyebrow fade">Columbus City Council</div>
      <h1 class="fade d1">Find your Columbus City Council <em>district</em>.</h1>
      <p class="lede fade d2">Nine districts. More than 900,000 residents. Look up who represents you, see how your district compares, and find out what's on the 2026 ballot.</p>
      <div class="cta-row fade d2">
        <a class="btn primary" href={`${b}all-districts/`} data-ev="find_district_click" data-ev-label="home-hero">Find your district
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a class="btn ghost" href={`${b}how-it-works/`}>How the council works</a>
      </div>
      <p class="fade d2" style="margin:1.1rem 0 0;font-size:.9rem;color:var(--ink-3);">For zoning, transit, permits, and 311 at your exact address, <a href="https://civicworth.com" target="_blank" rel="noopener">look it up on CivicWorth</a>.</p>
    </div>
    <div class="mapcard home-map fade d1">
      <h2>The nine districts <span class="compass">&#9650; N</span></h2>
      <div class="mapwrap">
        <svg class="districtmap home" id="dmap" viewBox={boundaries.viewBox} role="img" aria-label="Interactive map of the nine Columbus City Council districts">
          {Object.keys(boundaries.paths).sort().map((n) => (
            <g class="grp" data-d={n}>
              <a href={`${b}districts/${slugs[n]}/`}>
                <path class="dist" data-d={n} d={(boundaries.paths as Record<string,string>)[n]} />
                <g class="dlab" data-d={n}>
                  <circle cx={centroids[n][0]} cy={centroids[n][1]} r="17" />
                  <text x={centroids[n][0]} y={centroids[n][1] + 6.5} text-anchor="middle">{n}</text>
                </g>
              </a>
            </g>
          ))}
        </svg>
        <div class="maptip" id="maptip"></div>
      </div>
      <div class="maplegend">
        <span>Hover a district to see its council member &middot; click to explore</span>
      </div>
      <div class="provenance"><span class="dot"></span> Boundaries from CivicWorth &middot; official 2023 council map</div>
    </div>
  </div></div></section>

  {/* ---- Who represents you ---- */}
  <section class="block"><div class="wrap">
    <div class="sec-head"><span class="n">All nine</span><h2>Who represents you</h2></div>
    <div class="dgrid">
      {cards.map((c) => (
        <a class="dcard" href={`${b}districts/${c.slug}/`} aria-label={`District ${c.number}: ${c.member}`}>
          <div class="dc-top"><span class="dc-num">District {c.number}</span><span class="dc-arr">&rarr;</span></div>
          <div class="dc-mem">{c.member}</div>
          <div class="dc-nb">{c.neighborhoods}</div>
          <div class="dc-stat"><b class="tnum">{c.pop2020.toLocaleString("en-US")}</b> residents <span class="dc-src">2020 Census</span></div>
        </a>
      ))}
    </div>
  </div></section>

  <div class="wrap"><div class="divider"></div></div>

  {/* ---- Two-band: how it works + ballot ---- */}
  <section class="block"><div class="wrap">
    <div class="twoband">
      <div class="bandcard dark">
        <span class="k">New to the district system?</span>
        <h3>How Columbus City Council works</h3>
        <p>Columbus uses a hybrid system: members must live in the district they represent, but every voter in the city votes on all nine seats. Here's why &mdash; and what it means for you.</p>
        <a href={`${b}how-it-works/`}>Read the explainer &rarr;</a>
      </div>
      <div class="bandcard ballot">
        <span class="k">On the November 2026 ballot</span>
        <h3>A vote on how council is elected</h3>
        <p>Columbus voters will decide two charter amendments on how City Council is elected &mdash; a citizen measure for district-only elections and a Council measure expanding the body to 13 members. Both are on the November ballot. Understand what's on your ballot before you vote.</p>
        <a href={`${b}2026-ballot/`} data-ev="ballot_engagement" data-ev-label="home-band">See what's on the ballot &rarr;</a>
      </div>
    </div>
  </div></section>

  {/* ---- FAQ ---- */}
  <section class="block" style="padding-top:0;"><div class="wrap">
    <div class="sec-head"><span class="n">FAQ</span><h2>Columbus City Council districts, answered</h2></div>
    <div class="faq">
      {faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
          {f.more && (
            <p class="faq-more">
              {f.more.map((m, i) => (
                <Fragment>
                  {i > 0 && <span class="sep"> &middot; </span>}
                  <a href={m.href} {...(m.external ? { target: "_blank", rel: "noopener" } : {})}>{m.text} &rarr;</a>
                </Fragment>
              ))}
            </p>
          )}
        </div>
      ))}
    </div>
  </div></section>

  {/* ---- Quick links ---- */}
  <section class="block" style="padding-top:0;"><div class="wrap">
    <div class="quick">
      <a href={`${b}all-districts/`}><svg class="qi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-6-5.3-6-10a6 6 0 0 1 12 0c0 4.7-6 10-6 10Z"/><circle cx="12" cy="11" r="2"/></svg><span class="ql">Find your district</span><span class="qd">Compare all nine</span></a>
      <a href="https://www.ohiosos.gov/elections/voters/" target="_blank" rel="noopener"><svg class="qi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3 8-8"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/></svg><span class="ql">Register to vote</span><span class="qd">Ohio Secretary of State</span></a>
      <a href="https://www.columbus.gov/Government/City-Council" target="_blank" rel="noopener"><svg class="qi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg><span class="ql">Council meetings</span><span class="qd">Calendar &amp; public comment</span></a>
      <a href={`${b}data/`}><svg class="qi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19V5M10 19V9M16 19v-6M22 19H2"/></svg><span class="ql">District data</span><span class="qd">Trends &amp; methodology</span></a>
    </div>
  </div></section>

  <script is:inline set:html={`
    (function(){
      var MEMBERS = ${membersJSON};
      var svg = document.getElementById('dmap'); if(!svg) return;
      var tip = document.getElementById('maptip'); var wrap = svg.parentElement;
      svg.querySelectorAll('g.grp').forEach(function(g){
        var d = g.getAttribute('data-d');
        var p = g.querySelector('path.dist');
        function show(){
          var r = wrap.getBoundingClientRect(), bb = p.getBoundingClientRect();
          tip.innerHTML = '<b>District '+d+'</b> <span class="sub">\\u00B7 '+MEMBERS[d]+'</span>';
          tip.style.left = (bb.left - r.left + bb.width/2)+'px';
          tip.style.top = (bb.top - r.top + bb.height/2)+'px';
          tip.style.opacity = 1;
          g.classList.add('on');
        }
        function hide(){ tip.style.opacity = 0; g.classList.remove('on'); }
        g.addEventListener('mouseenter', show); g.addEventListener('mouseleave', hide);
        g.addEventListener('focusin', show); g.addEventListener('focusout', hide);
      });
    })();
  `}></script>

<style>
  .faq { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .faq { grid-template-columns: 1fr 1fr; } }
  .faq-item { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.2rem; background: var(--surface); }
  .faq-item h3 { font-family: var(--serif); font-weight: 500; font-size: 1.12rem; margin: 0 0 .4rem; }
  .faq-item p { margin: 0; color: var(--ink-2); font-size: .94rem; line-height: 1.55; }
  .faq-item .faq-more { margin: .7rem 0 0; font-size: .86rem; }
  .faq-item .faq-more a { font-weight: 600; }
  .faq-item .faq-more .sep { color: var(--ink-3); }
</style>
</Layout>

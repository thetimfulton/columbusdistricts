---
/**
 * data.astro — Data & Trends: dumbbell change charts across ACS vintages + change table
 * + methodology. Rebuilt from design-concepts/data.html, data-driven from the district JSONs.
 */
import Layout from "../components/Layout.astro";
import { districts, currentSnapshot, priorSnapshot } from "../lib/districts";
import { formatReviewDate, LAST_REVIEWED } from "../lib/site";

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
const reviewed = formatReviewDate();
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

// Temporal coverage from the ACS vintages actually loaded (e.g. 2017–2021 … 2019–2023).
const allVintages: string[] = districts[0].demographics.snapshots.map((s: any) => s.vintage);
const vintageYears = allVintages.join(" ").match(/\d{4}/g)?.map(Number) ?? [];
const covStart = vintageYears.length ? Math.min(...vintageYears) : null;
const covEnd = vintageYears.length ? Math.max(...vintageYears) : null;

const datasetLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Columbus City Council district demographics",
  description:
    "Population, income, housing, and demographic estimates for each of the nine Columbus City Council districts, aggregated from U.S. Census American Community Survey 5-year estimates and tracked across ACS vintages.",
  url: pageUrl,
  ...(covStart && covEnd ? { temporalCoverage: `${covStart}/${covEnd}` } : {}),
  spatialCoverage: { "@type": "Place", name: "Columbus, Ohio, United States" },
  isAccessibleForFree: true,
  dateModified: LAST_REVIEWED,
  sourceOrganization: {
    "@type": "GovernmentOrganization",
    name: "U.S. Census Bureau",
    url: "https://www.census.gov/programs-surveys/acs",
  },
  provider: { "@type": "Organization", name: "CivicWorth", url: "https://civicworth.com" },
  measurementTechnique: "American Community Survey 5-year estimates, aggregated to council districts from census block groups",
};
const money = (n: number) => "$" + Math.round(n).toLocaleString("en-US");
const num = (n: number) => Math.round(n).toLocaleString("en-US");
const pct = (n: number) => n.toFixed(1) + "%";

const curV = districts[0].demographics.current_vintage;
const priorV = priorSnapshot(districts[0])?.vintage ?? null;
const enDash = (v: string | null) => (v ? v.replace(/(\d{4})-(\d{4})/, "$1–$2") : "");

// Dumbbell chart for one metric: each district's baseline -> current value on a shared scale.
function dumbbell(key: string, fmt: (n: number) => string) {
  const vals: number[] = [];
  const pre = districts.map((d: any) => {
    const cur = currentSnapshot(d).data[key];
    const base0 = priorSnapshot(d)?.data[key] ?? cur;
    vals.push(cur, base0);
    return { n: d.number, base: base0, cur };
  });
  const min = Math.min(...vals);
  const max = Math.max(...vals);
  const span = max - min || 1;
  const norm = (v: number) => ((v - min) / span) * 100;
  return {
    min,
    max,
    fmt,
    rows: pre.map((r) => {
      const p0 = norm(r.base);
      const p1 = norm(r.cur);
      const chg = ((r.cur - r.base) / r.base) * 100;
      return { ...r, p0, p1, connLeft: Math.min(p0, p1), connW: Math.abs(p1 - p0), chg };
    }),
  };
}
const income = dumbbell("median_hh_income_est", money);
const homeValue = dumbbell("median_home_value_est", money);

// Change table (current value + change since prior vintage)
const changeMetrics = [
  { label: "Population", key: "total_population", fmt: num, kind: "pct" as const },
  { label: "Median rent", key: "median_gross_rent_est", fmt: money, kind: "pct" as const },
  { label: "Unemployment", key: "unemployment_rate", fmt: pct, kind: "pts" as const },
];
const changeRows = changeMetrics.map((m) => ({
  ...m,
  cells: districts.map((d: any) => {
    const cur = currentSnapshot(d).data[m.key];
    const prev = priorSnapshot(d)?.data[m.key];
    let chg = "";
    if (prev != null) {
      if (m.kind === "pts") {
        const delta = cur - prev;
        chg = `${delta >= 0 ? "+" : "−"}${Math.abs(delta).toFixed(1)}`;
      } else {
        const delta = ((cur - prev) / prev) * 100;
        chg = `${delta >= 0 ? "+" : "−"}${Math.abs(delta).toFixed(0)}%`;
      }
    }
    return { value: m.fmt(cur), chg };
  }),
}));
---
<Layout
  fullTitle="Columbus Council District Demographics & Trends"
  title="District data & trends"
  description="Demographics and trends for the nine Columbus City Council districts — income, rent, home value, and unemployment across ACS vintages, with full methodology."
  active="data"
  jsonLd={datasetLd}
>
  <div class="wrap">
    <section class="block" style="padding-bottom:1rem;">
      <div class="sec-head"><span class="n">Data &amp; methodology</span><h1>Columbus City Council district demographics &amp; trends</h1></div>
      <p class="sec-sub">Columbus Districts tracks each district across American Community Survey (ACS) 5-year vintages, so you can see change over time &mdash; not just a single snapshot. Two vintages are loaded today; a new one is added each December as the Census Bureau releases it.</p>
      <div class="vhist">
        <span class="vchip old"><i class="vd"></i> {enDash(priorV)} <span style="color:var(--ink-3)">&middot; baseline</span></span>
        <span class="vchip new"><i class="vd"></i> {enDash(curV)} <span style="color:var(--ink-3)">&middot; current</span></span>
        <span class="vchip" style="border-style:dashed;color:var(--ink-3)">ACS 2020&ndash;2024 &middot; expected Dec 2026</span>
      </div>

      {[{ t: "Median household income", d: income }, { t: "Median home value", d: homeValue }].map((chart) => (
        <div class="vizcard">
          <h3>{chart.t}</h3>
          <div class="vsub">Change from the {enDash(priorV)} baseline to the current {enDash(curV)} estimate, by district</div>
          <div class="dumb">
            {chart.d.rows.map((r) => (
              <div class="dumb-row">
                <div class="dumb-lab">District {r.n}</div>
                <div class="dumb-track">
                  <div class="base"></div>
                  <div class="conn" style={`left:${r.connLeft}%;width:${r.connW}%`}></div>
                  <div class="d0" style={`left:${r.p0}%`}></div>
                  <div class="d1" style={`left:${r.p1}%`}></div>
                </div>
                <div class="dumb-chg"><span class="ar">&#9650;</span> {Math.round(r.chg)}%</div>
              </div>
            ))}
          </div>
          <div class="dumb-scale"><span></span><div class="ends"><span>{chart.d.fmt(chart.d.min)}</span><span>{chart.d.fmt(chart.d.max)}</span></div><span></span></div>
          <div class="viz-legend"><span><i class="k0"></i> {enDash(priorV)}</span><span><i class="k1"></i> {enDash(curV)}</span><span>Each row is a district; the line shows the change</span></div>
        </div>
      ))}

      <h3 style="font-family:var(--serif);font-weight:500;font-size:1.3rem;margin:1.4rem 0 .3rem;">Population, rent &amp; unemployment</h3>
      <p style="font-size:.86rem;color:var(--ink-3);margin:0 0 1rem;">Current value with change since the prior vintage. Scroll sideways for all nine districts.</p>
      <div class="cmptable-wrap">
        <table class="cmpt" style="min-width:820px">
          <thead><tr>
            <th class="dcol" style="text-align:left">Metric ({enDash(curV)}, change since {enDash(priorV)})</th>
            {districts.map((d: any) => <th>D{d.number}</th>)}
          </tr></thead>
          <tbody>
            {changeRows.map((row) => (
              <tr>
                <td class="dcol" style="text-align:left">{row.label}</td>
                {row.cells.map((c) => (
                  <td><span class="num">{c.value}</span><span style="color:var(--ink-3);font-size:.72rem"> {c.chg}</span></td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="block" style="padding-top:1rem;"><div class="method">
      <div class="sec-head"><span class="n">Methodology</span><h2>How to read these figures</h2></div>
      <h3>About the ACS 5-year estimates</h3>
      <p>The American Community Survey 5-year estimate is a rolling average over five years of surveys, not a single-year count. It's the most reliable Census source for areas the size of a council district, but because it's an average, it lags fast-moving change by a couple of years.</p>
      <h3>Why district figures are aggregated</h3>
      <p>Council districts don't line up with Census geographies, so every district figure here is <strong>built up from census block groups</strong> assigned to that district. Median income, rent, and home value are <strong>pooled medians</strong>: each block group&rsquo;s ACS income, home-value, and rent distribution tables are apportioned to the district, and the median is interpolated from the combined distribution. Pooling all nine districts this way reproduces the Census Bureau&rsquo;s published citywide Columbus medians within about 1%. These are still survey estimates, so treat small gaps between districts as within the margin of error. Dollar figures are in each vintage&rsquo;s own dollars (2021 dollars for 2017&ndash;2021, 2023 dollars for 2019&ndash;2023) and are not adjusted for inflation between vintages.</p>
      <h3>ACS vs. Esri current-year estimates</h3>
      <p>Where available, each district page also shows Esri's current-year estimate for comparison. Esri projects forward from the 2020 Census using building permits and migration data, so in fast-growing districts it can run ahead of the backward-looking ACS average. Neither is "wrong" &mdash; they answer slightly different questions.</p>
      <div class="flag"><b>Corrected in the latest refresh.</b> District 2's aggregated population and District 3's Asian-population count near the OSU campus &mdash; previously distorted by a hand-built block crosswalk &mdash; have been re-derived by assigning census block groups to districts against the official CivicWorth 2023 council polygons, weighted by 2020-Census block population. The result is validated against the official 2020 count within ~1% for every district.</div>
      <div class="flag"><b>Updated September 2026.</b> Median income, rent, and home value were previously population-weighted averages of block-group medians, which overstated district income by roughly 10% on average (up to 17% in District 3) and District 7&rsquo;s home value by about 23%. They are now pooled medians as described above. Both ACS vintages were recomputed the same way, so the change charts remain apples-to-apples.</div>
      <h3>Sources &amp; corrections</h3>
      <p>Demographics: U.S. Census Bureau ACS via <a href="https://civicworth.com" target="_blank" rel="noopener">CivicWorth</a>. Boundaries: official City of Columbus 2023 council map. Found an error? Every district page has a &ldquo;Suggest an edit&rdquo; form, and corrections are made quickly.</p>
      <p>These figures stop at the district level. To explore the same underlying data at the individual address and parcel level &mdash; representation, zoning, transit, and 311 &mdash; or to browse Columbus civic maps, see <a href="https://civicworth.com/columbus" target="_blank" rel="noopener">CivicWorth&rsquo;s Columbus hub</a>.</p>
      <p style="font-size:.82rem;color:var(--ink-3);margin-top:1.6rem;padding-top:1rem;border-top:1px solid var(--line);">Last reviewed: {reviewed}</p>
    </div></section>
  </div>
</Layout>

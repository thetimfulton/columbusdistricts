---
/**
 * name-the-districts.astro — community district-naming suggestions.
 * A single form with a district selector (one visible Turnstile widget) — robust vs. the
 * earlier per-district accordions, which hid the widget and broke Turnstile's render.
 *
 * Phase C: posts to /api/name (Cloudflare Pages Function): honeypot + Turnstile → Formspree
 * → thank-you. Progressive enhancement; Turnstile is the only JS-dependent piece.
 */
import Layout from "../components/Layout.astro";

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const districts = [1, 2, 3, 4, 5, 6, 7, 8, 9];
---
<Layout
  title="Name the Districts"
  description="Should Columbus's nine City Council districts have names? Share your idea — an open, community-driven suggestion box."
  active=""
>
  <div class="wrap"><div class="article">
    <section class="art-hero">
      <div class="eyebrow">Community</div>
      <h1>Name the Districts</h1>
      <p class="dek">Columbus's nine City Council districts are identified by number only. Should they have names? If so, what should they be called?</p>
    </section>

    <p>We've been collecting community suggestions since the districts were established in 2023. There is no official naming process at this time, but this page stays open to gather ideas — and we'll share updates here if a path forward emerges.</p>

    <h2>Suggest a name</h2>
    <p>Pick a district and suggest a name. Add a brief note on why it fits, if you'd like.</p>

    <div class="form-wrap" style="max-width:560px;">
      <form method="POST" action={`${b}api/name`}>
        {/* Honeypot — bots fill this; humans never see it. */}
        <div style="position:absolute;left:-9999px;" aria-hidden="true">
          <label>Leave this field empty <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label for="nd-district">District</label>
        <select id="nd-district" name="district" required>
          {districts.map((d) => <option value={d}>District {d}</option>)}
        </select>
        <label for="nd-name">Your name</label>
        <input id="nd-name" name="name" type="text" autocomplete="name" required />
        <label for="nd-email">Email address</label>
        <input id="nd-email" name="email" type="email" autocomplete="email" required />
        <label for="nd-suggestion">Suggested name</label>
        <input id="nd-suggestion" name="suggested_name" type="text" required />
        <label for="nd-reason">Why this name? (optional)</label>
        <textarea id="nd-reason" name="reason"></textarea>
        {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="auto" style="margin-top:1rem;"></div>}
        <button class="btn primary" type="submit">Submit name</button>
      </form>
    </div>
  </div></div>
</Layout>

<style>
  .form-wrap select {
    width: 100%;
    padding: .7rem .8rem;
    border: 1px solid var(--line-2);
    border-radius: 9px;
    background: var(--surface);
    color: var(--ink);
    font-family: inherit;
    font-size: .95rem;
  }
</style>

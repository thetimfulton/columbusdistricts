---
/**
 * all-districts.astro — Comparison table of all nine districts + Columbus weighted-average row.
 * Rebuilt from design-concepts/all-districts.html. Population uses the 2020 Census count
 * (avoids ACS artifacts per the brief); income/rent/unemployment/race are current ACS.
 */
import Layout from "../components/Layout.astro";
import { districts, currentSnapshot, citywide, citywideSum } from "../lib/districts";

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
const money = (n: number) => "$" + Math.round(n).toLocaleString("en-US");
const num = (n: number) => Math.round(n).toLocaleString("en-US");
const pct = (n: number) => n.toFixed(1) + "%";

const rows = districts.map((d: any) => {
  const c = currentSnapshot(d).data;
  return {
    number: d.number,
    slug: d.slug,
    member: d.councilMember.name,
    pop2020: d.population2020 ?? c.total_population,
    income: c.median_hh_income_est,
    rent: c.median_gross_rent_est,
    unemp: c.unemployment_rate,
    white: c.pct_nh_white,
    black: c.pct_nh_black,
    hispanic: c.pct_hispanic,
    next: d.councilMember.nextElection,
  };
});

// Column leaders (accent): highest median income, lowest unemployment (matches concept)
const leadIncome = Math.max(...rows.map((r) => r.income));
const leadUnemp = Math.min(...rows.map((r) => r.unemp));

// Columbus weighted-average row
const city = {
  pop: citywideSum("total_population") && rows.reduce((a, r) => a + r.pop2020, 0),
  income: citywide("median_hh_income_est"),
  rent: citywide("median_gross_rent_est"),
  unemp: citywide("unemployment_rate"),
  white: citywide("pct_nh_white"),
  black: citywide("pct_nh_black"),
  hispanic: citywide("pct_hispanic"),
};

// Superlatives
const byIncomeDesc = [...rows].sort((a, b2) => b2.income - a.income);
const hiInc = byIncomeDesc[0];
const loInc = byIncomeDesc[byIncomeDesc.length - 1];
const loUnemp = [...rows].sort((a, b2) => a.unemp - b2.unemp)[0];
const pctVsCity = (v: number) => {
  const c = city.income ?? v;
  const p = (v - c) / c * 100;
  return `${p >= 0 ? "+" : "−"}${Math.abs(p).toFixed(0)}%`;
};
const nextYear = Math.min(...rows.map((r) => r.next).filter(Boolean));
const nextDistricts = rows.filter((r) => r.next === nextYear).map((r) => r.number);
---
<Layout
  title="All nine districts, compared"
  description="Every Columbus City Council district across the same demographic and civic measures — population, income, rent, unemployment, and race/ethnicity — with a citywide comparison row."
  active="all"
>
  <div class="wrap">
    <section class="block" style="padding-bottom:1.4rem;">
      <div class="sec-head"><span class="n">Compare</span><h2>All nine districts, side by side</h2></div>
      <p class="sec-sub">Every Columbus City Council district across the same demographic and civic measures. Population is the 2020 Census count; income, rent, unemployment, and race/ethnicity are ACS 2019&ndash;2023 estimates. Tap a district to open its page.</p>

      <div class="super">
        <div class="sup"><div class="sk">Highest median income</div><div class="sv">District {hiInc.number}</div><div class="sd">{money(hiInc.income)} &middot; <b>{pctVsCity(hiInc.income)}</b> vs. city</div></div>
        <div class="sup"><div class="sk">Lowest median income</div><div class="sv">District {loInc.number}</div><div class="sd">{money(loInc.income)} &middot; {pctVsCity(loInc.income)} vs. city</div></div>
        <div class="sup"><div class="sk">Lowest unemployment</div><div class="sv">District {loUnemp.number}</div><div class="sd">{pct(loUnemp.unemp)} &middot; city is {pct(city.unemp ?? 0)}</div></div>
        <div class="sup"><div class="sk">Next up for election</div><div class="sv">{nextYear}</div><div class="sd">Districts {nextDistricts.join(", ")}</div></div>
      </div>

      <div class="cmptable-wrap">
        <table class="cmpt">
          <thead><tr>
            <th class="dcol">District</th><th style="text-align:left">Council member</th><th>Population</th><th>Median income</th><th>Median rent</th><th>Unemployment</th><th>% NH White</th><th>% NH Black</th><th>% Hispanic</th><th>Next election</th>
          </tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td class="dcol"><a class="dlink" href={`${b}districts/${r.slug}/`}>District {r.number}</a></td>
                <td class="mcol">{r.member}</td>
                <td><span class="num">{num(r.pop2020)}</span></td>
                <td class={r.income === leadIncome ? "lead" : ""}><span class="num">{money(r.income)}</span></td>
                <td><span class="num">{money(r.rent)}</span></td>
                <td class={r.unemp === leadUnemp ? "lead" : ""}><span class="num">{pct(r.unemp)}</span></td>
                <td><span class="num">{pct(r.white)}</span></td>
                <td><span class="num">{pct(r.black)}</span></td>
                <td><span class="num">{pct(r.hispanic)}</span></td>
                <td><span class="num">{r.next}</span></td>
              </tr>
            ))}
            <tr class="city">
              <td class="dcol">Columbus</td>
              <td class="mcol" style="color:var(--ink-3);font-weight:400;font-size:.82rem;">weighted average</td>
              <td><span class="num">{num(city.pop)}</span></td>
              <td><span class="num">{money(city.income ?? 0)}</span></td>
              <td><span class="num">{money(city.rent ?? 0)}</span></td>
              <td><span class="num">{pct(city.unemp ?? 0)}</span></td>
              <td><span class="num">{pct(city.white ?? 0)}</span></td>
              <td><span class="num">{pct(city.black ?? 0)}</span></td>
              <td><span class="num">{pct(city.hispanic ?? 0)}</span></td>
              <td>&mdash;</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="legend-note"><span><b>Accent</b> marks the leading district in a column</span><span>Scroll the table sideways to see every measure &rarr;</span></div>
      <p class="datanote"><strong>About these figures.</strong> Demographics are aggregated from census block groups; median income, rent, and home value are population-weighted averages of block-group medians &mdash; approximations, not true district medians. The Columbus row is a population-weighted average of the nine districts. <a href={`${b}data/`}>See full methodology &rarr;</a></p>
    </section>
  </div>
</Layout>

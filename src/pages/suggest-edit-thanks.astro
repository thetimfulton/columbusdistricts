---
import Layout from "../components/Layout.astro";
const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
---
<Layout title="Thanks for your suggestion" description="Your suggestion has been submitted to Columbus Districts." ribbon={false}>
  <div class="wrap"><div class="article">
    <section class="art-hero">
      <div class="eyebrow">Suggest an edit</div>
      <h1>Thank you</h1>
      <p class="dek">Your suggestion has been received. We review submissions periodically and update the site when corrections are confirmed against primary sources.</p>
    </section>
    <p><a href={b}>&larr; Return to the homepage</a></p>
  </div></div>
</Layout>

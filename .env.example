# Columbus Districts — environment variables
# Copy to .env for local dev; set the real values in the Cloudflare Pages dashboard
# (Settings → Environment variables) for production. PUBLIC_* vars are baked into the
# static build at build time; the others are read at runtime by the Pages Functions.

# --- Analytics (build-time, client-side) ---
# GA4 Measurement ID — the existing property, so traffic history stays continuous.
PUBLIC_GA_MEASUREMENT_ID=G-KEEV757MNS
# Cloudflare Web Analytics beacon token (from the Cloudflare dashboard → Web Analytics).
PUBLIC_CF_BEACON_TOKEN=
# Cloudflare Turnstile widget SITE key (public). Leave empty locally to skip the widget.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Forms (runtime, Cloudflare Pages Functions — server-side only, never PUBLIC_) ---
# Turnstile SECRET key (verification is skipped if unset — honeypot still applies).
TURNSTILE_SECRET_KEY=
# Formspree form id — submissions are delivered here; set the destination inbox
# (info@columbusdistricts.com) in the Formspree dashboard. Shared by both forms unless
# you set the per-form overrides below.
FORMSPREE_FORM_ID=
# Optional: separate Formspree forms per submission type (recommended — separate inboxes).
FORMSPREE_SUGGEST_ID=
FORMSPREE_NAME_ID=
